{
  "name": "@thestreamcode/openclaw-command-code",
  "version": "0.1.1",
  "description": "Command Code (commandcode.ai) model provider plugin for OpenClaw with live model discovery",
  "type": "module",
  "license": "MIT",
  "private": false,
  "author": {
    "name": "Michael Gasperini",
    "url": "https://mikesoft.it"
  },
  "repository": "github:TheStreamCode/openclaw-command-code",
  "homepage": "https://clawhub.ai/plugins/@thestreamcode/openclaw-command-code",
  "bugs": {
    "url": "https://github.com/TheStreamCode/openclaw-command-code/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/TheStreamCode"
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist",
    "prepack": "npm run build"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "command-code",
    "commandcode",
    "llm",
    "provider"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "providers": [
      "commandcode"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.9.5",
      "pluginSdkVersion": "2026.9.5"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "devDependencies": {
    "openclaw": "2026.10.5",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
